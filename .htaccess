# ---------- Default document ----------
DirectoryIndex index.php index.html

# ---------- URL rewriting ----------
RewriteEngine On
RewriteBase /

# Force HTTPS + www → non-www.
# (Comment these two blocks out for local http:// testing.)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---------- Clean URLs (extensionless) ----------
# 1) Send /index.php (and /index) to the site root.
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2) Redirect any external *.php request to its clean, extensionless URL
#    (avoids duplicate content: /privacy.php → /privacy).
RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Renamed post: /shopify-b2b-wholesale-basic-plan -> /shopify-b2b-starter-guide
#    The article was rewritten from a Basic-plan piece into the general Shopify
#    B2B starter guide, so the old slug no longer describes it. Keep this for as
#    long as the old URL has inbound links — Google has already crawled it in
#    sitemap.xml. Must sit above rule 4, or the clean-URL rewrite serves the old
#    path first.
RewriteRule ^shopify-b2b-wholesale-basic-plan/?$ /shopify-b2b-starter-guide [R=301,L]

# 3b) Renamed app page: the app was rebranded to DQ: B2B Request a Quote (RFQ).
#     Old URL is live and already in sitemap.xml, so it must keep resolving.
RewriteRule ^dqlab-request-quote-hide-price/?$ /dq-b2b-request-quote-rfq [R=301,L]

# 4) Internally serve the matching .php file for a clean URL.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header unset X-Powered-By
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- Browser caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType image/svg+xml svg svgz
  AddType application/xml xml
  AddType image/webp webp
  AddType image/avif avif
</IfModule>

# ---------- Block sensitive files ----------
<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|\.env|\.git|README\.md)$">
  Require all denied
</FilesMatch>

# ---------- Block direct access to design package ----------
RedirectMatch 404 /\.design-package(/|$)

# ---------- Block direct access to server-side includes ----------
RedirectMatch 404 /inc(/|$)

# ---------- Block direct access to runtime state (view counts) ----------
RedirectMatch 404 /data(/|$)

# ---------- Custom error pages ----------
ErrorDocument 404 /404.php

# ---------- Disable directory listing ----------
Options -Indexes
