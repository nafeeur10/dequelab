# Runtime state only — never served over HTTP.
# The root .htaccess also 404s this path; this is defence in depth for
# hosts where the root rules are not applied.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
